{
    "name"        : "oasis/dynamodb-odm",
    "description" : "ODM for dynamodb",
    "type"        : "library",
    "require"     : {
        "php"                : ">=8.5",
        "oasis/aws-wrappers" : "^3.0",
        "oasis/logging"      : "^3.0",
        "symfony/console"    : "^7.0",
        "symfony/finder"     : "^7.0",
        "ext-json"           : "*"
    },
    "require-dev" : {
        "phpunit/phpunit"      : "^13.0",
        "giorgiosironi/eris"   : "^1.0",
        "symfony/yaml"         : "^7.0"
    },
    "license"     : "MIT",
    "authors"     : [
        {
            "name" : "Minhao Zhang",
            "email": "minhao.zhang@qq.com"
        }
    ],
    "autoload"    : {
        "psr-4": {
            "Oasis\\Mlib\\ODM\\Dynamodb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oasis\\Mlib\\ODM\\Dynamodb\\Ut\\": "ut/"
        }
    },
    "bin"         : [
        "bin/oasis-dynamodb-odm"
    ]
